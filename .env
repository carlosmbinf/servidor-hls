# Configuración local/producción del servidor HLS.
# Este archivo está ignorado por Git. Reemplaza los valores entre <...>.

NODE_ENV=production
PORT=3050

# DDP seguro del backend Meteor. Debe terminar en /websocket.
METEOR_DDP_ENDPOINT=wss://www.vidkar.com/websocket
# Origen HTTP/HTTPS del backend Meteor para consultas auxiliares.
METEOR_HTTP_ORIGIN=https://www.vidkar.com

# Genera dos secretos aleatorios distintos y largos; no los compartas n>

# Rutas y operación local.
HLS_CACHE_DIR=./.vidkar-cache/peliculas-hls
SERIES_HLS_CACHE_DIR=./.vidkar-cache/series-hls
COURSES_HLS_CACHE_DIR=./.vidkar-cache/cursos-hls
FFMPEG_PATH=/usr/bin/ffmpeg
HLS_IDLE_TIMEOUT_MS=60000
HLS_KILL_GRACE_MS=10000
HLS_UPSTREAM_TIMEOUT_MS=30000
HLS_PROBE_TIMEOUT_MS=30000
METEOR_CONNECT_TIMEOUT_MS=30000
ADMIN_SESSION_MAX_AGE_MS=28800000
# Debe coincidir con la variable del proceso Meteor; no exponerla al cliente.
HLS_RUNTIME_TOKEN=940517